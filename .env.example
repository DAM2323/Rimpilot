# Backend
ASSEMBLYAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DATABASE_URL=
PUBLIC_URL=https://your-subdomain.ngrok.app
PORT=3001
# Firma el token del Media Stream. Mínimo 32 caracteres: openssl rand -base64 32
STREAM_TOKEN_SECRET=
# Tope de sesiones simultáneas contra la clave compartida de AssemblyAI.
# Es un solo contador para el teléfono y para el micrófono del navegador.
MAX_LLAMADAS_CONCURRENTES=5
# Clave servidor-a-servidor con la que el panel pide el token del micrófono.
# Mínimo 32 caracteres: openssl rand -base64 32. Sin ella el canal web da 503.
RIMPILOT_INTERNAL_KEY=
# Orígenes que pueden abrir el WebSocket del navegador, separados por coma
# (ej.: https://rimpilot.vercel.app). Vacío = solo localhost.
RIMPILOT_ORIGENES_PERMITIDOS=
# Solo para pruebas o staging. Vacío = API real de AssemblyAI.
ASSEMBLYAI_VOICE_URL=

# Vendedor inicial para `pnpm --filter @rimpilot/backend seed`.
# El teléfono es obligatorio; el script falla si falta, no inventa ninguno.
SEED_VENDOR_TELEFONO=
SEED_VENDOR_NOMBRE=
SEED_VENDOR_NEGOCIO=

# Dashboard: copy packages/dashboard/.env.local.example to packages/dashboard/.env.local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RIMPILOT_VENDOR_ID=
