# Backend
ASSEMBLYAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DATABASE_URL=
PUBLIC_URL=https://your-subdomain.ngrok.app
PORT=3001
# Firma el token del Media Stream. Mínimo 32 caracteres: openssl rand -base64 32
STREAM_TOKEN_SECRET=
# Topes de gasto contra la clave compartida de AssemblyAI (regla 17). Cada
# uno cuenta el teléfono y el micrófono del navegador juntos.
#   Sesiones abiertas a la vez:
MAX_LLAMADAS_CONCURRENTES=5
#   Sesiones por vendedor por día (día de Lima):
MAX_SESIONES_POR_VENDEDOR_DIA=20
#   Sesiones por día en total. Es el que acota el gasto de verdad: el modo
#   invitado da una cuenta por visita y cada una trae su propia cuota diaria.
MAX_SESIONES_DIA=200
#   Minutos máximos por sesión, para que una pestaña olvidada no facture sola:
MAX_MINUTOS_POR_SESION=10
# Clave servidor-a-servidor con la que el panel pide el token del micrófono.
# Mínimo 32 caracteres: openssl rand -base64 32. Sin ella el canal web da 503.
RIMPILOT_INTERNAL_KEY=
# Orígenes que pueden abrir el WebSocket del navegador, separados por coma
# (ej.: https://rimpilot.vercel.app). Vacío = solo localhost.
RIMPILOT_ORIGENES_PERMITIDOS=
# Solo para pruebas o staging. Vacío = API real de AssemblyAI.
ASSEMBLYAI_VOICE_URL=

# La voz de Wari. Vacío = lola, la única del catálogo con acento nativo en
# español (de España). Las demás hablan español con acento inglés:
#   mujeres: alba, eve, jane, jean, mary, anna, vera
#   hombres: george, michael, charles, paul
# Solo se aceptan nombres del catálogo; uno inventado no arranca el backend.
# Catálogo: https://www.assemblyai.com/docs/voice-agents/voice-agent-api/voices
ASSEMBLYAI_VOZ=

# Vendedor del canal telefónico para `pnpm --filter @rimpilot/backend seed`.
# Quien entra por la web no necesita esto: crea su cuenta desde la página.
# El teléfono es obligatorio; el script falla si falta, no inventa ninguno.
SEED_VENDOR_TELEFONO=
SEED_VENDOR_NOMBRE=
SEED_VENDOR_NEGOCIO=

# Dashboard: copy packages/dashboard/.env.local.example to packages/dashboard/.env.local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RIMPILOT_SESSION_SECRET=
