# This file must live in packages/dashboard/.env.local for Next.js to load it.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# UUID from the vendedores table for this single-business MVP dashboard.
RIMPILOT_VENDOR_ID=
# Basic Auth del panel. Sin estas dos el panel responde 503 y no muestra nada.
# La contraseña debe tener al menos 16 caracteres: openssl rand -base64 24
RIMPILOT_DASHBOARD_USER=
RIMPILOT_DASHBOARD_PASSWORD=
# URL pública del panel: alimenta metadata, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Micrófono del navegador. RIMPILOT_BACKEND_URL lo usa el servidor de Next para
# pedir el token; NEXT_PUBLIC_BACKEND_WS_URL lo usa el navegador para abrir el
# WebSocket, y su origen entra en connect-src de la CSP.
RIMPILOT_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:3001/navegador/stream
# La misma clave que RIMPILOT_INTERNAL_KEY en el .env del backend.
RIMPILOT_INTERNAL_KEY=
